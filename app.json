{
  "expo": {
    "name": "PawCruz",
    "slug": "frontend-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./src/screens/assets/paw2.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./src/screens/assets/paw2-adaptive.png",
        "backgroundColor": "#FFFFFF"
      },
      "softwareKeyboardLayoutMode": "resize",
      "package": "PawCruz.App"
    },
    "web": {
      "favicon": "./src/screens/assets/webpaw.png"
    },
    "plugins": [
      "expo-video",
      "expo-secure-store",
      "expo-asset",
      [
        "expo-notifications",
        {
          "icon": "./src/screens/assets/paw2.png",
          "color": "#063B55"
        }
      ],
      "expo-status-bar",
      [
        "expo-splash-screen",
        {
          "image": "./src/screens/assets/paw2-splash.png",
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF"
        }
      ],
      "expo-audio"
    ],
    "extra": {
      "eas": {
        "projectId": "261aac43-01b0-4811-93dc-98d30f976696"
      }
    }
  }
}
